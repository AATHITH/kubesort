# Get available sort fields for a resource type
get_sort_fields() {
    local resource=$1
    local fields=()
    
    for key in "${!SORT_FIELDS[@]}"; do
        if [[ $key == "$resource,"* ]]; then
            field_name=${key#*,}
            fields+=("$field_name")
        fi
    done
    
    printf "%s\n" "${fields[@]}" | sort
}

# Get all supported resource types
get_resource_types() {
    local types=()
    for key in "${!RESOURCE_MAP[@]}"; do
        types+=("$key")
    done
    printf "%s\n" "${types[@]}" | sort -u
}

# Generate dynamic help
help() {
cat << EOF
🔍 KubeSort - Dynamic Kubernetes Resource Sorter v1.0.0

Usage:
    kubesort kubectl get <resource_type> <sort_field> [-n namespace|-A|--all-namespaces]

Examples:
    kubesort kubectl get pods name                     # Sort pods by name in default namespace
    kubesort kubectl get deployments age -A           # Sort deployments by age across all namespaces  
    kubesort kubectl get nodes status                  # Sort nodes by status
    kubesort kubectl get pvc capacity -n kube-system  # Sort PVCs by capacity in kube-system namespace
    kubesort kubectl get services port -n default     # Sort services by port in default namespace

📋 Supported Resources:
EOF

    echo
    # Get unique canonical resource names
    local unique_resources=($(for v in "${RESOURCE_MAP[@]}"; do echo "$v"; done | sort -u))
    
    for canonical_resource in "${unique_resources[@]}"; do
        echo "   🔸 $canonical_resource:"
        echo "      Aliases: $(printf "%s " $(for k in "${!RESOURCE_MAP[@]}"; do [[ "${RESOURCE_MAP[$k]}" == "$canonical_resource" ]] && echo "$k"; done | sort))"
        echo "      Sort fields: $(get_sort_fields "$canonical_resource" | tr '\n' ', ' | sed 's/, $//')"
        echo
    done

    cat << EOF

🎯 Namespace Options:
    - Specific namespace: Use -n <namespace> (e.g., '-n kube-system', '-n default')
    - All namespaces: Use -A or --all-namespaces
    - Default: If no namespace flag specified, uses current context's default namespace

💡 Tips:
    - All sort fields are based on standard kubectl output columns
    - Use 'name' as sort field for alphabetical sorting
    - Use 'age' for chronological sorting (newest/oldest first)
    - Resource aliases follow kubectl conventions (e.g., 'po' for pods, 'svc' for services)

EOF
    exit 0
}

# Validate resource type and get canonical name
validate_resource() {
    local input_resource=$1
    if [[ -n "${RESOURCE_MAP[$input_resource]}" ]]; then
        resource_type="${RESOURCE_MAP[$input_resource]}"
        return 0
    else
        echo "❌ Error: Unsupported resource type '$input_resource'"
        echo "💡 Run 'kubesort kubectl get help' to see all supported resources"
        exit 1
    fi
}

# Validate sort field
validate_sort_field() {
    local resource=$1
    local field=$2
    local key="$resource,$field"
    
    if [[ -n "${SORT_FIELDS[$key]}" ]]; then
        sort_field="${SORT_FIELDS[$key]}"
        return 0
    else
        echo "❌ Error: Invalid sort field '$field' for resource '$resource'"
        echo "💡 Available sort fields for $resource: $(get_sort_fields "$resource" | tr '\n' ', ' | sed 's/, $//')"
        exit 1
    fi
}

# Execute kubectl with sorting
execute_kubectl() {
    local resource=$1
    local sort_by=$2
    local namespace_flag=$3
    local namespace_value=$4
    
    local kubectl_cmd="kubectl get $resource --sort-by=$sort_by"
    
    # Handle namespace options
    if [[ "$namespace_flag" == "--all-namespaces" ]]; then
        kubectl_cmd="$kubectl_cmd --all-namespaces"
    elif [[ "$namespace_flag" == "-n" && -n "$namespace_value" ]]; then
        kubectl_cmd="$kubectl_cmd -n $namespace_value"
    fi
    # If no namespace specified, kubectl uses current context's default namespace
    
    # Add wide output for better visibility
    kubectl_cmd="$kubectl_cmd -o wide"
    
    echo "🚀 Executing: $kubectl_cmd"
    echo "─────────────────────────────────────────────────────────────"
    
    # Execute the command
    eval "$kubectl_cmd"
}

# Parse namespace arguments
parse_namespace_args() {
    local -n args_ref=$1
    local start_index=$2
    local namespace_flag=""
    local namespace_value=""
    
    # Check for namespace flags
    local i=$start_index
    while [[ $i -lt ${#args_ref[@]} ]]; do
        if [[ "${args_ref[$i]}" == "--all-namespaces" || "${args_ref[$i]}" == "-A" ]]; then
            namespace_flag="--all-namespaces"
            break
        elif [[ "${args_ref[$i]}" == "-n" && $((i+1)) -lt ${#args_ref[@]} ]]; then
            namespace_flag="-n"
            namespace_value="${args_ref[$((i+1))]}"
            break
        fi
        ((i++))
    done
    
    echo "$namespace_flag|$namespace_value"
}

# Main execution logic
main() {
    # Initialize resource definitions
    init_resources
    
    # Check if basic kubectl get structure is correct
    if [[ "$1" != "kubectl" || "$2" != "get" ]]; then
        help
    fi
    
    # Handle help requests
    if [[ "$3" == "help" || "$3" == "" || "$4" == "help" || "$4" == "" ]]; then
        help
    fi
    
    # Parse basic arguments
    local input_resource="$3"
    local input_sort_field="$4"
    
    # Parse namespace arguments (starting from position 4, which is after sort_field)
    local args=("$@")
    local namespace_info=$(parse_namespace_args args 4)
    local namespace_flag="${namespace_info%|*}"
    local namespace_value="${namespace_info#*|}"
    
    # Validate inputs
    validate_resource "$input_resource"
    validate_sort_field "$resource_type" "$input_sort_field"
    
    # Execute the kubectl command
    execute_kubectl "$resource_type" "$sort_field" "$namespace_flag" "$namespace_value"
}

# Run main function with all arguments
main "$@"
